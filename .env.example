# Optional. The /setup screen saves the same settings to ~/.virtualdm/config.json;
# only use this file if you prefer env vars. config.json wins if both are set.

# Required. Postgres connection string from Supabase → Connect → Session pooler.
SUPABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Required. The DM's brain. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional. DM voice + scene/map art. Blank = system text-to-speech, no art.
OPENAI_API_KEY=

# Optional. Not used yet. Supabase → Settings → API Keys → service_role.
SUPABASE_SERVICE_KEY=

# Optional. ≥24 random URL-safe chars. Only matters if you expose the server to
# claude.ai as an MCP connector (path /mcp/<secret>). Auto-generated if blank.
CONNECTOR_SECRET=

# Optional. Campaign to open by default (printed by scripts/seed_campaign.py).
# Blank = choose from the picker.
DEFAULT_CAMPAIGN_ID=

# Optional. 2014 (default) or 2024 rules.
RULES_EDITION=2014

# Optional. Local port for the web UI.
PORT=8080
